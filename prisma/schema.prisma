// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  favoriteTeam String? // GS | FB | BJK | null
  balance      Int      @default(1000)
  startBalance Int      @default(1000)
  createdAt    DateTime @default(now())

  predictions Prediction[]

  sentTransfers     Transfer[] @relation("SentTransfers")
  receivedTransfers Transfer[] @relation("ReceivedTransfers")
  sentGifts         Gift[]     @relation("SentGifts")
  receivedGifts     Gift[]     @relation("ReceivedGifts")
  pushTokens        PushToken[]
}

// An Expo push token for one installation of the mobile app. A user can have
// several (phone + tablet, reinstall), so the token — not the user — is the
// unique key. Rows are disposable: Expo tells us when a token has gone stale
// ("DeviceNotRegistered") and lib/push.ts deletes it, so they cascade away
// with the user rather than being worth preserving.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A direct virtual-balance transfer between two players. Kept as its own row
// (rather than only mutating balances) so the wallet can show an audit trail
// and so a transfer is never confused with prediction winnings.
model Transfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Int
  note        String?
  createdAt   DateTime @default(now())

  sender    User @relation("SentTransfers", fields: [senderId], references: [id])
  recipient User @relation("ReceivedTransfers", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// A "sürpriz kupon": the sender pays `price`, the house keeps `fee`, and the
// rest is staked on a randomly drawn prediction created in the RECIPIENT's
// name. The recipient can't see which selection they got until they open it.
model Gift {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  price        Int // total charged to the sender
  fee          Int // packaging fee, not staked
  stake        Int // price - fee
  predictionId String    @unique
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  sender     User       @relation("SentGifts", fields: [senderId], references: [id])
  recipient  User       @relation("ReceivedGifts", fields: [recipientId], references: [id])
  prediction Prediction @relation(fields: [predictionId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model Match {
  id            String   @id @default(cuid())
  externalId    String   @unique
  homeTeam      String
  awayTeam      String
  league        String?
  kickoff       DateTime
  oddsHome      Float
  oddsDraw      Float
  oddsAway      Float
  prevOddsHome  Float?
  prevOddsDraw  Float?
  prevOddsAway  Float?

  // Extra markets beyond 1X2, when the odds provider supplies them.
  over25    Float?
  under25   Float?
  bttsYes   Float?
  bttsNo    Float?
  dc1X      Float? // double chance 1-X
  dc12      Float? // double chance 1-2
  dcX2      Float? // double chance X-2
  extraMarkets Json?

  oddsUpdatedAt DateTime @default(now())
  status        String   @default("upcoming") // upcoming | live | finished
  result        String? // 1X2 outcome: "1" | "X" | "2"
  resultOver25  Boolean? // total goals > 2.5
  resultBtts    Boolean? // both teams scored
  homeScore     Int? // current/final score — set while live too, as a display-only in-play score
  awayScore     Int?
  // When homeScore/awayScore was last refreshed from a live source (real
  // results API or the Nesine scrape fallback). Lets a fresh page load skip
  // re-scraping a match that was already checked moments ago, without
  // needing an in-memory cache that wouldn't survive across serverless
  // instances anyway.
  liveScoreUpdatedAt DateTime?

  // Short AI-written pre-match note (lib/aiAnalysis.ts). Generated in the
  // background by the cron, never on a page load — producing one takes
  // several seconds of model + web-search time.
  aiAnalysis   String?
  aiAnalysisAt DateTime?

  // Set the first time a "maç birazdan başlıyor" push goes out for this
  // match. The cron runs every ~60s, so without a marker every tick inside
  // the reminder window would re-notify the same people.
  startingSoonNotifiedAt DateTime?

  // The scoreline the last goal notification was sent for, as "H-A". Compared
  // against a freshly scraped score to tell an actual goal from a re-read of
  // the same score. Null until the first live score arrives.
  notifiedScore String?

  createdAt     DateTime @default(now())

  predictions Prediction[]
}

model Prediction {
  id         String    @id @default(cuid())
  userId     String
  matchId    String
  market     String    @default("1X2") // "1X2" | "OU25" | "BTTS" | "DC"
  choice     String // 1X2: "1"|"X"|"2" · OU25: "OVER"|"UNDER" · BTTS: "YES"|"NO" · DC: "1X"|"12"|"X2"
  stake      Int
  oddsAtPick Float
  status     String    @default("open") // open | won | lost
  payout     Int?
  createdAt  DateTime  @default(now())
  settledAt  DateTime?

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])
  gift  Gift?

  @@index([userId])
  @@index([matchId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Null for accounts created through Google/Apple sign-in — they have no
  // password to check, so the password login path must reject them rather
  // than comparing against an empty hash.
  passwordHash String?
  displayName  String
  favoriteTeam String? // GS | FB | BJK | null
  balance      Int      @default(1000)
  startBalance Int      @default(1000)
  createdAt    DateTime @default(now())

  // Bookkeeping for lib/season.ts's applyPeriodicAdjustments: the week/season
  // start this user was last checked/reset for. Null until the first tick
  // after SEASON_ONE_START touches them — that's what lets a single nullable
  // column double as "never processed" for every existing row.
  weekAnchor   DateTime?
  seasonAnchor DateTime?

  predictions Prediction[]

  sentTransfers     Transfer[] @relation("SentTransfers")
  receivedTransfers Transfer[] @relation("ReceivedTransfers")
  sentGifts         Gift[]     @relation("SentGifts")
  receivedGifts     Gift[]     @relation("ReceivedGifts")
  pushTokens        PushToken[]
  oauthAccounts     OAuthAccount[]

  weeklyChampionships WeeklyChampion[]
  seasonChampionships SeasonChampion[]
  seasonPerks         SeasonPerk[]
  ownedLeagues        League[]           @relation("LeagueOwner")
  leagueMemberships   LeagueMembership[]
}

// A third-party identity linked to a user (Google, Apple). Kept as its own
// table rather than columns on User so one account can carry several
// providers — signing in with Apple on the phone and Google on a tablet must
// land on the same user, not create a second one.
//
// `providerUserId` is the provider's stable subject claim ("sub"), never the
// email: an email can change hands, the subject can't.
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // google | apple
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// An Expo push token for one installation of the mobile app. A user can have
// several (phone + tablet, reinstall), so the token — not the user — is the
// unique key. Rows are disposable: Expo tells us when a token has gone stale
// ("DeviceNotRegistered") and lib/push.ts deletes it, so they cascade away
// with the user rather than being worth preserving.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A direct virtual-balance transfer between two players. Kept as its own row
// (rather than only mutating balances) so the wallet can show an audit trail
// and so a transfer is never confused with prediction winnings.
model Transfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Int
  note        String?
  createdAt   DateTime @default(now())

  sender    User @relation("SentTransfers", fields: [senderId], references: [id])
  recipient User @relation("ReceivedTransfers", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// A "sürpriz kupon": the sender pays `price`, the house keeps `fee`, and the
// rest is staked on a randomly drawn prediction created in the RECIPIENT's
// name. The recipient can't see which selection they got until they open it.
model Gift {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  price        Int // total charged to the sender
  fee          Int // packaging fee, not staked
  stake        Int // price - fee
  predictionId String    @unique
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  sender     User       @relation("SentGifts", fields: [senderId], references: [id])
  recipient  User       @relation("ReceivedGifts", fields: [recipientId], references: [id])
  prediction Prediction @relation(fields: [predictionId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model Match {
  id            String   @id @default(cuid())
  externalId    String   @unique
  homeTeam      String
  awayTeam      String
  league        String?
  kickoff       DateTime
  oddsHome      Float
  oddsDraw      Float
  oddsAway      Float
  prevOddsHome  Float?
  prevOddsDraw  Float?
  prevOddsAway  Float?

  // Extra markets beyond 1X2, when the odds provider supplies them.
  over25    Float?
  under25   Float?
  bttsYes   Float?
  bttsNo    Float?
  dc1X      Float? // double chance 1-X
  dc12      Float? // double chance 1-2
  dcX2      Float? // double chance X-2
  extraMarkets Json?

  oddsUpdatedAt DateTime @default(now())
  // upcoming | live | finished | postponed. "postponed" is settlement.ts
  // giving up on ever getting a real result (no confirmed data, no observed
  // scoreline either) rather than fabricating one — its open predictions are
  // cancelled and refunded instead of settled. It drops out of
  // getUpcomingMatches' upcoming|live filter, same as "finished".
  status        String   @default("upcoming")
  result        String? // 1X2 outcome: "1" | "X" | "2"
  resultOver25  Boolean? // total goals > 2.5
  resultBtts    Boolean? // both teams scored
  homeScore     Int? // current/final score — set while live too, as a display-only in-play score
  awayScore     Int?
  // When homeScore/awayScore was last refreshed from a live source (real
  // results API or the Nesine scrape fallback). Lets a fresh page load skip
  // re-scraping a match that was already checked moments ago, without
  // needing an in-memory cache that wouldn't survive across serverless
  // instances anyway.
  liveScoreUpdatedAt DateTime?

  // Short AI-written pre-match note (lib/aiAnalysis.ts). Generated in the
  // background by the cron, never on a page load — producing one takes
  // several seconds of model + web-search time.
  aiAnalysis   String?
  aiAnalysisAt DateTime?

  // Set the first time a "maç birazdan başlıyor" push goes out for this
  // match. The cron runs every ~60s, so without a marker every tick inside
  // the reminder window would re-notify the same people.
  startingSoonNotifiedAt DateTime?

  // The scoreline the last goal notification was sent for, as "H-A". Compared
  // against a freshly scraped score to tell an actual goal from a re-read of
  // the same score. Null until the first live score arrives.
  notifiedScore String?

  createdAt     DateTime @default(now())

  predictions Prediction[]

  // Weekly kasa and haftalık/sezonluk sıralama both group predictions by
  // their match's kickoff week (lib/season.ts), which Prisma resolves as a
  // join + range filter on this column.
  @@index([kickoff])
}

model Prediction {
  id         String    @id @default(cuid())
  userId     String
  matchId    String
  market     String    @default("1X2") // "1X2" | "OU25" | "BTTS" | "DC"
  choice     String // 1X2: "1"|"X"|"2" · OU25: "OVER"|"UNDER" · BTTS: "YES"|"NO" · DC: "1X"|"12"|"X2"
  stake      Int
  oddsAtPick Float
  // open | won | lost | cancelled. "cancelled" is a match that ended up
  // "postponed" (see Match.status) — the stake was refunded, payout stays
  // null, and it counts toward neither the weekly kasa nor the leaderboard.
  status     String    @default("open")
  payout     Int?
  createdAt  DateTime  @default(now())
  settledAt  DateTime?

  // This week's Banko (lib/banko.ts enforces at most one true per user per
  // week — there's no DB constraint for it since "week" isn't a stored
  // column, only derived from the match's kickoff). A won Banko's payout is
  // doubled at settlement; a lost one costs exactly what any other pick would.
  isBanko Boolean @default(false)

  // Set by settlement.ts when this pick lost but was covered by the sigorta
  // joker (lib/perks.ts) — the stake was refunded (payout = stake) rather
  // than lost, and status stays "lost" since the pick itself was still wrong.
  // Denormalized here (rather than joined from SeasonPerk at read time) so
  // every wallet/leaderboard/activity read site can branch on it directly.
  wasInsured Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])
  gift  Gift?

  @@index([userId])
  @@index([matchId])
}

// One row per Pazartesi 09:00 award — the player with the highest net kâr
// over the week that just closed. `weekStart` is unique so the award itself
// doubles as the idempotency guard: awardWeeklyChampionIfDue() creates this
// row inside a try/catch on the unique-constraint violation, so a race
// between overlapping cron/page-load ticks can only ever award once.
model WeeklyChampion {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @unique
  net       Int
  bonus     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Same idea as WeeklyChampion, but for the season that just closed — awarded
// alongside the season-boundary balance reset in applyPeriodicAdjustments.
model SeasonChampion {
  id          String   @id @default(cuid())
  userId      String
  seasonStart DateTime @unique
  net         Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// One row per joker actually used. `kind` is "double_kasa" | "insurance".
// The @@unique on (userId, seasonStart, kind) is the enforcement mechanism
// for "once per season, per joker" — activating a joker is a `create` that
// either succeeds or throws a unique-constraint error, no separate
// check-then-write race to guard against.
model SeasonPerk {
  id          String   @id @default(cuid())
  userId      String
  seasonStart DateTime
  kind        String
  // double_kasa: which week's kasa it doubles.
  weekStart   DateTime?
  // insurance: which prediction it protects. Unique so a prediction can only
  // ever be insured once (redundant with the per-season unique above, since
  // that already caps a user to one insurance activation per season, but
  // keeps the column's own meaning airtight).
  predictionId String?  @unique
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, seasonStart, kind])
  @@index([userId])
}

// A private, invite-code-joined mini league. Ranking within it reuses the
// same net-kâr leaderboard logic as the global board, just scoped to member
// ids — there is no separate scoring system for leagues.
model League {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())

  owner   User               @relation("LeagueOwner", fields: [ownerId], references: [id])
  members LeagueMembership[]
}

model LeagueMembership {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
  @@index([userId])
}

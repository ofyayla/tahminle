{
  "expo": {
    "name": "Tahminle",
    "slug": "tahminle",
    "scheme": [
      "tahminle",
      "com.tahminle.app"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tahminle.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tahminle.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0d16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#f6c945"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0d16",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "googleOAuth": {
        "ios": "265643465032-a8aea9qk634ajpi3v7k1fa57dbe5v9fa.apps.googleusercontent.com",
        "android": "",
        "web": "265643465032-02a8jo5g6mvbg6gnmhg4mp21ijtdbcdl.apps.googleusercontent.com"
      },
      "router": {},
      "eas": {
        "projectId": "1b8e0a1e-5ffd-449c-a41c-5aebc311ad0e"
      }
    }
  }
}
